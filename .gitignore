# Python caches and build outputs
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
.env

# Local application state
.thermo_acoustic_ui.json

# Hardware smoke-test and capture outputs
ad2_scope_capture.*
ad2_matplotlib_plot.*
hamamatsu_snapshot.*
frame_*.tif
frame_*.tiff
frame_*.npy
*.tdms

# Logs and temporary files
*.log
*.err
*.tmp
*.bak
~$*

# pytest --basetemp scratch directories (this machine's tmp_path fixture hits
# PermissionError, so tests are run with --basetemp=.pytest_tmp* project-
# relative dirs instead -- these are throwaway test output and must never be
# committed, see the accidental commit cleaned up in a prior session).
.pytest_tmp*/
_pytest_tmp/

# Editor and OS metadata
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# Codex/local agent scratch state
.agents/
.claude/

# Local manual hardware probes that can issue real Thorlabs/PPC001 actions.
# Keep out of the tracked automated test tree unless reviewed and renamed.
hardware_tests/manual_ppc001_piezo_probe.py

# Real-hardware verification run artifacts (TIFF frames, TDMS files, dated
# run folders) -- multiple prior sessions (piezo Z-scan Session 48, camera/
# AD2/full-workflow smoke runs, this session's Priority 1 hardware
# verification) used to write here; despite being referenced as "gitignored"
# in earlier changelog entries, no rule for it actually existed until now
# (found while cleaning up after Session 51's real-hardware pass) -- these
# are throwaway verification outputs, never meant to be committed. Superseded
# by runs/ below (file/structure audit cleanup); rule kept in case anything
# still writes here.
hardware_tests/output/

# Real-hardware verification run artifacts and stray real-hardware output
# files (e.g. a loose data.tdms) now live under this top-level directory
# instead of hardware_tests/output/ or the repo root -- one obvious place for
# "real hardware run evidence" (file/structure audit cleanup). Same rationale
# as hardware_tests/output/ above: throwaway/reproducible verification
# outputs, never meant to be committed.
runs/
